# Copy to .env for local runs. Never commit .env.

# Claude API (agents + evals only; never in the browser)
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
# Secret (service_role) key: agents only, never in the browser
SUPABASE_SERVICE_ROLE_KEY=

# Web app (public by design; row-level security limits access)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Eval cost cap per full run, in USD
EVAL_COST_CAP_USD=1.00
